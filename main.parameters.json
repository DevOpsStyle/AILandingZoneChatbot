{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "targetSubscriptionId": { "value": "00000000-0000-0000-0000-000000000000" },
    "location":            { "value": "swedencentral" },
    "locations": {
      "value": {
        "network":      "",
        "logAnalytics": "",
        "keyVault":     "",
        "foundry":      "",
        "search":       "",
        "apim":         "",
        "cosmos":       "",
        "serviceBus":   "",
        "redis":        ""
      }
    },
    "resourceGroupName":         { "value": "" },
    "resourceGroupWorkloadName": { "value": "" },
    "resourceGroupHubName":      { "value": "" },
    "resourceGroupApimName":     { "value": "" },
    "useExistingResourceGroup": { "value": false },
    "namePrefix":          { "value": "aifp" },
    "nameSalt":            { "value": "" },
    "vnetHubAddressPrefix":      { "value": "10.10.0.0/16" },
    "subnetAppGwPrefix":         { "value": "10.10.1.0/24" },
    "vnetApimAddressPrefix":     { "value": "10.20.0.0/16" },
    "subnetApimPrefix":          { "value": "10.20.1.0/24" },
    "subnetApimPePrefix":        { "value": "10.20.2.0/24" },
    "vnetWorkloadAddressPrefix": { "value": "10.30.0.0/16" },
    "subnetPePrefix":            { "value": "10.30.1.0/24" },
    "subnetAcaPrefix":           { "value": "10.30.4.0/23" },
    "models": {
      "value": [
        { "deploymentName": "gpt-5-mini", "modelName": "gpt-5-mini", "format": "OpenAI", "version": "2025-08-07", "skuName": "GlobalStandard", "capacity": 50 }
      ]
    },
    "apimPublisherEmail":  { "value": "admin@contoso.com" },
    "apimPublisherName":   { "value": "Contoso" },
    "apimSku":             { "value": "StandardV2" },
    "cosmosApi":           { "value": "NoSQL" },
    "kvSku":               { "value": "standard" },
    "searchSku":           { "value": "standard" },
    "searchReplicas":      { "value": 1 },
    "searchPartitions":    { "value": 1 },
    "cosmosCapacityMode":  { "value": "Provisioned" },
    "sbCapacity":          { "value": 1 },
    "redisSku":            { "value": "Balanced_B5" },

    "enableComponents": {
      "value": {
        "keyVault":   true,
        "aiSearch":   true,
        "apim":       true,
        "cosmos":     true,
        "serviceBus": true,
        "redis":      true
      }
    },

    "enableDiagnostics":   { "value": true },
    "diagnosticsPerResource": {
      "value": {
        "foundry":    true,
        "search":     true,
        "apim":       true,
        "cosmos":     true,
        "serviceBus": true,
        "redis":      true,
        "keyVault":   true
      }
    },

    "enableDefender":      { "value": true },
    "defenderPlans": {
      "value": {
        "VirtualMachines":               true,
        "AppServices":                   true,
        "SqlServers":                    true,
        "SqlServerVirtualMachines":      true,
        "StorageAccounts":               true,
        "KeyVaults":                     true,
        "Arm":                           true,
        "Containers":                    true,
        "CosmosDbs":                     true,
        "OpenSourceRelationalDatabases": false,
        "Api":                           true,
        "AI":                            true
      }
    },

    "tags": {
      "value": {
        "workload":  "ai-foundry-private",
        "managedBy": "arm",
        "env":       "demo"
      }
    }
  }
}
